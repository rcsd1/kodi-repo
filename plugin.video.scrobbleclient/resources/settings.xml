<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Every label here is a numeric string id resolved from
  resources/language/resource.language.en_gb/strings.po

  This is not optional. Kodi's version="1" settings format ignores plain text
  in a label attribute, which renders the whole screen blank. See
  https://kodi.wiki/view/Add-on_settings
-->
<settings version="1">
    <section id="plugin.video.scrobbleclient">

        <category id="connection" label="30000">
            <group id="1" label="30000">
                <setting id="store_url" type="string" label="30010" help="30014">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30010</heading>
                    </control>
                </setting>
                <setting id="device_token" type="string" label="30011" help="30015">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30011</heading>
                    </control>
                </setting>
                <setting id="test_connection" type="action" label="30012">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=test)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
            </group>
        </category>

        <category id="playback" label="30001">
            <group id="1" label="30001">
                <setting id="auto_resume" type="boolean" label="30020">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="ask_before_resume" type="boolean" label="30023">
                    <level>0</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="visible" setting="auto_resume" operator="is">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
                <setting id="resume_rewind_sec" type="integer" label="30024">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>5</step>
                        <maximum>60</maximum>
                    </constraints>
                    <control type="slider" format="integer"/>
                </setting>
                <setting id="show_notifications" type="boolean" label="30021">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="min_progress_sec" type="integer" label="30022">
                    <level>0</level>
                    <default>60</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>10</step>
                        <maximum>600</maximum>
                    </constraints>
                    <control type="slider" format="integer"/>
                </setting>
            </group>
        </category>

        <category id="lists" label="30002">
            <group id="1" label="30002">
                <setting id="rec_tier" type="string" label="30030">
                    <level>0</level>
                    <default>any</default>
                    <constraints>
                        <options>
                            <option label="30032">any</option>
                            <option label="30033">popular</option>
                            <option label="30034">under_the_radar</option>
                            <option label="30035">obscure</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
                <setting id="widget_limit" type="integer" label="30031">
                    <level>0</level>
                    <default>50</default>
                    <constraints>
                        <minimum>5</minimum>
                        <step>5</step>
                        <maximum>200</maximum>
                    </constraints>
                    <control type="slider" format="integer"/>
                </setting>
                <setting id="show_opens" type="string" label="30091">
                    <level>0</level>
                    <default>tmdbhelper</default>
                    <constraints>
                        <options>
                            <option label="30092">tmdbhelper</option>
                            <option label="30093">builtin</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
                <setting id="show_percent" type="boolean" label="30036">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="rec_languages" type="string" label="30037" help="30038">
                    <level>0</level>
                    <default>en,ja,ko,zh</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30037</heading>
                    </control>
                </setting>
                <setting id="rec_min_votes" type="integer" label="30039" help="30047">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>100</step>
                        <maximum>10000</maximum>
                    </constraints>
                    <control type="slider" format="integer"/>
                </setting>
                <setting id="rec_exclude_genres" type="string" label="30048" help="30049">
                    <level>1</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30048</heading>
                    </control>
                </setting>
            </group>
        </category>

        <category id="maintenance" label="30003">
            <group id="1" label="30003">
                <setting id="admin_token" type="string" label="30013" help="30016">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30013</heading>
                    </control>
                </setting>
                <setting id="watched_threshold" type="integer" label="30040">
                    <level>0</level>
                    <default>90</default>
                    <constraints>
                        <minimum>50</minimum>
                        <step>1</step>
                        <maximum>99</maximum>
                    </constraints>
                    <control type="slider" format="percentage"/>
                </setting>
                <setting id="apply_threshold" type="action" label="30041" help="30046">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=apply_threshold)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
                <setting id="fetch_artwork" type="action" label="30087" help="30046">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=artwork)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
                <setting id="show_stats" type="action" label="30045">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=stats)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
                <setting id="refresh_recs" type="action" label="30042">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=refresh_recs)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
                <setting id="update_anime" type="action" label="30043" help="30046">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=anime_ingest)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
                <setting id="run_backfill" type="action" label="30044" help="30046">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=backfill)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
            </group>
        </category>

        <category id="advanced" label="30004">
            <group id="1" label="30004">
                <setting id="debug_logging" type="boolean" label="30053">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="clear_queue" type="action" label="30054">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.scrobbleclient/?action=clear_queue)</data>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
                <setting id="play_url_movie" type="string" label="30050">
                    <level>2</level>
                    <default>plugin://plugin.video.themoviedb.helper/?info=play&amp;tmdb_type=movie&amp;tmdb_id={tmdb_id}</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30050</heading>
                    </control>
                </setting>
                <setting id="play_url_episode" type="string" label="30051">
                    <level>2</level>
                    <default>plugin://plugin.video.themoviedb.helper/?info=play&amp;tmdb_type=tv&amp;tmdb_id={tmdb_id}&amp;season={season}&amp;episode={episode}</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30051</heading>
                    </control>
                </setting>
                <setting id="tv_show_path" type="string" label="30052">
                    <level>2</level>
                    <default>plugin://plugin.video.themoviedb.helper/?info=seasons&amp;tmdb_type=tv&amp;tmdb_id={tmdb_id}</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30052</heading>
                    </control>
                </setting>
            </group>
        </category>

    </section>
</settings>
