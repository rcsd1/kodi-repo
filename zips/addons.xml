<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.scrobbleclient" name="Scrobble Client" version="1.19.0" provider-name="local">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="plugin.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Resume points and watched history against your own store</summary>
        <description lang="en_GB">Scrobbles playback to a self-hosted store and serves a Resume Watching list with progress indicators. Works with Seren, Umbrella, Fen and Otaku. Detects when Kodi delegates to an external player and hands off instead of scrobbling.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
        <license>MIT</license>
    </extension>
</addon>
<addon id="repository.scrobble" name="Scrobble Repository" version="1.0.0" provider-name="local">
    <extension point="xbmc.addon.repository" name="Scrobble Repository">
        <dir minversion="19.0.0">
            <info compressed="false">https://raw.githubusercontent.com/GITHUB_USER/GITHUB_REPO/main/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/GITHUB_USER/GITHUB_REPO/main/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/GITHUB_USER/GITHUB_REPO/main/zips/</datadir>
            <hashes>false</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Scrobble Repository</summary>
        <description lang="en_GB">Hosts the Scrobble Client addon and its updates.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
        <license>MIT</license>
    </extension>
</addon>
</addons>
